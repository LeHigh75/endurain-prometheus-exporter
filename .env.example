# Development examples only; generate independent random secrets for production.
DATABASE_URL=postgresql://endurain_exporter:replace-with-random-password@endurain-db:5432/endurain?sslmode=disable
# Optional Bearer authentication: set at least 32 random characters to enable it.
# Empty or unset delegates access control to your network or reverse proxy.
METRICS_TOKEN=

# The binary accepts DATABASE_URL_FILE and METRICS_TOKEN_FILE instead of the
# corresponding direct variables. Do not configure both sources for one secret.
# An explicitly configured secret file must exist and contain a nonempty value.
# DATABASE_URL_FILE=/run/secrets/endurain_database_url
# METRICS_TOKEN_FILE=/run/secrets/endurain_metrics_token

# Binary settings (Compose listens on port 9808 inside the container).
LISTEN_ADDRESS=:9808
SCRAPE_TIMEOUT=5s
MAX_SERIES=20000
# Opt-in: expose individual activity statistics and activity titles.
# All business series share MAX_SERIES; an overflow fails the complete scrape.
ACTIVITY_DETAILS=false

# Standalone Compose: existing Docker network shared with Endurain PostgreSQL.
# Set to <dockerhub-namespace>/endurain-prometheus-exporter:sha-<commit> to pull a published image.
EXPORTER_IMAGE=endurain-prometheus-exporter:local
ENDURAIN_NETWORK=replace-with-your-endurain-network
EXPORTER_PORT=9808

# Isolated development Compose only.
TEST_POSTGRES_PORT=55432
# TEST_DATABASE_URL=postgresql://endurain_owner:development-only-owner-password@127.0.0.1:55432/endurain_exporter_test?sslmode=disable
