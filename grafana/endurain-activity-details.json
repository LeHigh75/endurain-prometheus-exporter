            "uid": "${datasource}"
          },
          "expr": "(max(endurain_activity_detail_end_timestamp_seconds{job=\"endurain\",instance=~\"${instance:regex}\",user_id=~\"${user_id:regex}\",activity_id=~\"${activity_id:regex}\"}) * 1000) and on() (min(up{job=\"endurain\",instance=~\"${instance:regex}\"}) == 1 and min(endurain_up{job=\"endurain\",instance=~\"${instance:regex}\"}) == 1)",
          "instant": true,
          "range": false,
          "legendFormat": "End date"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
